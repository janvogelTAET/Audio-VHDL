add_cells_to_pblock [get_pblocks  {CLKAG_u_clk_rst/u_clk_gen/ac_bclk_po_OBUF}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=ac_mclk_po_OBUF_inst && NAME!=ac_bclk_po_OBUF_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_clk_rst/u_clk_gen/ac_bclk_po_OBUF"}]]]
