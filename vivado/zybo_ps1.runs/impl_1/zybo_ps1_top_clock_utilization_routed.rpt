set_property LOC BUFGCTRL_X0Y0 [get_cells u_clk_rst/u_clk_gen/u_bufg_ac_mclk]
set_property LOC BUFGCTRL_X0Y18 [get_cells u_clk_rst/u_clk_gen/u_mmcm1_fb_bufg]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y0 [get_cells ac_mclk_po_OBUF_inst]
set_property LOC IOB_X0Y75 [get_cells ac_bclk_po_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X0Y78 [get_ports clk_pi]

# Clock net "u_clk_rst/u_clk_gen/u_mmcm1_0" driven by instance "u_clk_rst/u_clk_gen/u_bufg_clk_sys" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_u_clk_rst/u_clk_gen/u_mmcm1_0}
add_cells_to_pblock [get_pblocks  {CLKAG_u_clk_rst/u_clk_gen/u_mmcm1_0}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=u_clk_rst/u_clk_gen/u_mmcm2} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_clk_rst/u_clk_gen/u_mmcm1_0"}]]]
resize_pblock [get_pblocks {CLKAG_u_clk_rst/u_clk_gen/u_mmcm1_0}] -add {CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "u_clk_rst/u_clk_gen/ac_bclk_po_OBUF" driven by instance "u_clk_rst/u_clk_gen/u_bufg_ac_mclk" located at site "BUFGCTRL_X0Y0"
